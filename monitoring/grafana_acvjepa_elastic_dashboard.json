    "gitops",
    "nccl",
    "recovery-epoch"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(acvjepa_training_plan_digest_consensus, cluster)",
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(acvjepa_training_plan_digest_consensus{cluster=\"$cluster\"}, job)",
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "environment",
